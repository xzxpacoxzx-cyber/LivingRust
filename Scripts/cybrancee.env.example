# Copy this file to Scripts/cybrancee.env and fill in the blanks.
# cybrancee.env is gitignored - it's never committed, and it holds no
# password (the password is typed once, live, into the real sftp prompt
# each time you run the sync-check script - never stored on disk).

CYBRANCEE_HOST=cybrancee-game-australia-17.cybrancee.com
CYBRANCEE_PORT=2022
CYBRANCEE_USER=
# Path to LivingRust.cszip on the server, relative to the SFTP login root.
# Pterodactyl-style panels (which Cybrancee's is based on) usually land you
# straight in the server's own root, so this is often just:
#   carbon/plugins/LivingRust.cszip
# Check with an interactive `sftp` session first (see README below) and
# correct this if your layout differs.
CYBRANCEE_REMOTE_CSZIP=carbon/plugins/LivingRust.cszip
