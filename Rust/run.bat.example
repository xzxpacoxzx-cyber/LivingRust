@echo off

SET root=%cd%
SET server=%root%\server
SET steam=%root%\steam

rem Update the dedicated server to the latest build before launching
"%steam%\steamcmd.exe" +force_install_dir "%server%" ^
             +login anonymous ^
             +app_update 258550 ^
             validate ^
             +quit

rem Settings
SET identity=LivingRust
SET name=My Carbon Test Server
SET size=4000
SET seed=61294184
SET port=28505
SET queryport=28506
SET rconPort=28507
SET rconPassword=CHANGE_ME

rem Start up the server
cd "%server%"
RustDedicated.exe -nographics -batchmode -logs -silent-crashes ^
                  -server.hostname "%name%" ^
                  -server.identity "%identity%" ^
                  -server.port %port% ^
                  -server.queryport %queryport% ^
                  -server.netlog ^
                  -server.saveinterval 400 ^
                  -rcon.port %rconPort% ^
                  -rcon.password "%rconPassword%" ^
                  -rcon.web true ^
                  -server.maxplayers 10 ^
                  -chat.serverlog 1 ^
                  +server.seed %seed% ^
                  +server.worldsize %size% ^
                  -logfile "%identity%_log.txt"